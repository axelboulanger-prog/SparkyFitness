{
  "expo": {
    "name": "SparkyFitnessMobile",
    "slug": "sparkyfitnessmobile",
    "scheme": "sparkyfitnessmobile",
    "orientation": "portrait",
    "icon": "./assets/icons/appstore.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "SparkyFitness reads Health data (such as activity, workouts, and body measurements) to display it in the app and sync it to your self-hosted SparkyFitness server.",
          "NSHealthUpdateUsageDescription": "SparkyFitness writes the nutrition and hydration you log in the app to Apple Health, keeping the two in sync.",
          "background": true
        }
      ],
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "react-native-health-connect",
        {
          "UIBackgroundModes": [],
          "permissions": [
            "android.permission.health.WRITE_NUTRITION",
            "android.permission.health.WRITE_HYDRATION"
          ]
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-asset",
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SparkyFitness needs access to your camera to scan food barcodes and labels.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e2e2e2",
          "imageWidth": 200,
          "image": "./assets/images/splash.png",
          "dark": {
            "backgroundColor": "#232323",
            "image": "./assets/images/splash.png"
          }
        }
      ],
      [
        "expo-notifications"
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "@bacons/apple-targets"
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "autolinkingModuleResolution": true
    },
    "extra": {
      "APP_VARIANT": "dev",
      "iosAppGroup": "group.org.SparkyApps.SparkyFitnessMobile1.dev",
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "org.SparkyApps.SparkyFitnessMobile1.dev.widget",
                  "targetName": "CalorieTracker",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.org.SparkyApps.SparkyFitnessMobile1.dev"
                    ]
                  }
                },
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "org.SparkyApps.SparkyFitnessMobile1.dev.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.org.SparkyApps.SparkyFitnessMobile1.dev"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "875b0a47-09be-4d59-b32b-ff62e423251a"
      }
    },
    "version": "1.6.4",
    "owner": "menistil"
  }
}
