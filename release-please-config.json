{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: release v${version}",
  "draft": true,
  "force-tag-creation": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "security", "section": "Security" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "sparkyfitness",
      "extra-files": [
        {
          "type": "json",
          "path": "SparkyFitnessServer/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "SparkyFitnessFrontend/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "SparkyFitnessMobile/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "shared/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "SparkyFitnessMobile/app.json",
          "jsonpath": "$.expo.version"
        },
        { "type": "generic", "path": "helm/chart/Chart.yaml" }
      ]
    }
  }
}
